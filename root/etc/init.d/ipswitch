#!/bin/sh /etc/rc.common
# ============================================================================
# ipswitch —— 出口 IP 切换服务
# ----------------------------------------------------------------------------
# 一个常驻的 HTTP 服务：收到 `GET /switch` 就换一次出口 IP
# （切 APN 或只重新拨号），完成时返回「IP切换完成」标记。
#
# ★ 它自己**不碰**模组串口。所有 AT 命令都经 MT5700 Console 后端
#   （127.0.0.1:8765）下发 —— 串口同一时刻只能有一个持有者，
#   再起一个进程去抢，会把 LuCI 页面和短信一起弄坏。
# ============================================================================

START=98
STOP=12

USE_PROCD=1
PROG=/usr/bin/ipswitchd
PROG_NAME=ipswitch

start_service() {
	# 依赖提示：没有 MT5700 Console 后端时本服务仍能启动（它会一直等后端
	# 出现），但换 IP 一定失败。先把话说明白，免得等到第一次切换报错才发现。
	[ -x /usr/bin/at-webserver-rust ] || \
		logger -t ipswitch "警告: 未发现 /usr/bin/at-webserver-rust（MT5700 Console 后端）；本服务会启动，但换 IP 将失败"

	procd_open_instance
	procd_set_param command "$PROG"
	# 1 小时内最多重启 5 次：配置写错时不该变成无限重启刷日志
	procd_set_param respawn 3600 5 5
	# 让 stderr/stdout 进 syslog —— 配置错误与切换失败都靠它暴露
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_close_instance
}

# 配置在进程启动时定型（见 src/rust/src/config.rs 的说明），
# 因此 reload 只能是"重启进程"。
reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ipswitch"
}
