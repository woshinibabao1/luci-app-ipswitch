#!/bin/sh
# ============================================================================
# ipswitch 安装后钩子：注册开机自启并启动一次。
#
# ★ 为什么不用 uci-defaults 做"配置初始化"：/etc/config/ipswitch 已经随包提供，
#   这里只做"让服务跑起来"一件事。保持单一职责。
#
# ★ 退出 0 会被 OpenWrt 删掉本脚本（表示一次性任务已完成）；
#   因此这里所有步骤都必须**幂等**，重复执行不能有副作用。
# ============================================================================

# init.d 的执行位可能在打包/刷机过程中丢失（本项目历史上真发生过），
# 先补上再 enable —— 否则 enable 会静默失败，服务永远不自启。
[ -x /etc/init.d/ipswitch ] || chmod 0755 /etc/init.d/ipswitch 2>/dev/null

/etc/init.d/ipswitch enable 2>/dev/null
/etc/init.d/ipswitch start 2>/dev/null

exit 0
